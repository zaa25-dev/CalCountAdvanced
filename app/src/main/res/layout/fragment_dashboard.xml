<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Summary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Line Chart View -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="20dp" />

    <!-- Metrics Summary -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Average Calories"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/tvAverageCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lowest Calorie Entry"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/tvMinCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Highest Calorie Entry"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/tvMaxCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Calories"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/tvTotalCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 cal"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>